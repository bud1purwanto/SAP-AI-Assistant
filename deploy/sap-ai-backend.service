[Unit]
Description=SAP AI Assistant FastAPI Backend Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=sapai
Group=sapai
WorkingDirectory=/opt/sap-ai-assistant/backend
Environment="PATH=/opt/sap-ai-assistant/backend/venv/bin:/usr/local/bin:/usr/bin"
EnvironmentFile=/opt/sap-ai-assistant/backend/.env

# Menjalankan Uvicorn dengan 4 worker di localhost port 8005 (port 8000 sudah dipakai aplikasi ABAP/lainnya)
ExecStart=/opt/sap-ai-assistant/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8005 --workers 4

# Auto restart on failure
Restart=always
RestartSec=5s

# Security Hardening
PrivateTmp=true
ProtectSystem=full
NoNewPrivileges=true

# Logging ke systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sap-ai-backend

[Install]
WantedBy=multi-user.target
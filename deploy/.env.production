# ==========================================================
# SAP AI ASSISTANT - PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================================
# Simpan file ini di: /opt/sap-ai-assistant/backend/.env

# --- OpenRouter AI API ---
# API Key OpenRouter (dapatkan di https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# AI Model default (bisa dioverride dari Admin Dashboard)
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_FALLBACK_MODEL=openrouter/free

# --- PostgreSQL Database (Production Persistence) ---
# Format: postgresql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://sap_admin:StrongPasswordHere123!@localhost:5432/sap_ai_db

# --- MCP SAP Gateway Configuration ---
# Mode SSE (Server-Sent Events) ke server MCP SAP internal
MCP_SAP_TYPE=sse
MCP_SAP_URL=http://127.0.0.1:8001/sse

# --- MCP RAG Knowledge Base Configuration ---
# Mode SSE ke server MCP Vector Knowledge Base
MCP_RAG_TYPE=sse
MCP_RAG_URL=http://127.0.0.1:8002/sse

# --- Assistant Persona ---
ASSISTANT_PERSONA="Anda adalah asisten AI Enterprise SAP expert yang bertugas membantu pengguna bernavigasi dan menganalisis sistem SAP ECC / S/4HANA serta Knowledge Base perusahaan secara akurat, profesional, dan ramah."
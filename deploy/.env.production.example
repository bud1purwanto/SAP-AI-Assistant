# ==========================================================
# SAP AI ASSISTANT - PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================================
# Salin ke /opt/sap-ai-assistant/backend/.env lalu isi nilainya.
# JANGAN commit berkas .env yang sudah berisi nilai asli.

# --- AI Provider: 9Router (Local Gateway / Primary) ---
NINE_ROUTER_ENABLED=true
NINE_ROUTER_BASE_URL=http://HOST:PORT/path
NINE_ROUTER_MODEL=isi-sesuai-lingkungan
NINE_ROUTER_API_KEY=ganti-dengan-api-key-anda

# --- AI Provider: OpenRouter (Cloud AI / Failover) ---
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=ganti-dengan-api-key-anda
OPENROUTER_MODEL=isi-sesuai-lingkungan
OPENROUTER_FALLBACK_MODEL=isi-sesuai-lingkungan

# --- PostgreSQL Database (Production Persistence) ---
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# --- MCP SAP Gateway Configuration ---
# Mode SSE (Server-Sent Events) ke server MCP SAP internal
MCP_SAP_TYPE=isi-sesuai-lingkungan
MCP_SAP_URL=http://HOST:PORT/path

# --- MCP RAG Knowledge Base Configuration ---
# Mode SSE ke server MCP Vector Knowledge Base
MCP_RAG_TYPE=isi-sesuai-lingkungan
MCP_RAG_URL=http://HOST:PORT/path

# --- Assistant Persona ---
ASSISTANT_PERSONA=

# --- Keamanan / Autentikasi (WAJIB di produksi) ---
# Secret penandatangan JWT. Buat dengan: openssl rand -base64 48
# Bila kosong, server memakai secret acak sementara sehingga semua sesi login
# gugur setiap restart dan tidak konsisten antar worker uvicorn.
JWT_SECRET=ganti-dengan-secret-acak-panjang
JWT_EXPIRE_MINUTES=720

# Origin frontend yang diizinkan, dipisahkan koma. Hindari "*" di produksi.
CORS_ALLOW_ORIGINS=https://sap-ai.internal

# Gagalkan startup bila PostgreSQL tidak terjangkau, alih-alih diam-diam
# beralih ke SQLite kosong.
REQUIRE_POSTGRES=true

# Password akun superadmin bootstrap (hanya dipakai saat tabel users kosong).
BOOTSTRAP_ADMIN_PASSWORD=ganti-saat-instalasi

# Kuota prompt harian untuk pengunjung yang belum login.
GUEST_DAILY_LIMIT=1

# ==============================================================================
# SAP AI Assistant - Contoh Konfigurasi (.env.example)
# ==============================================================================
# Salin file ini menjadi .env:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE POSTGRESQL (WAJIB)
# ------------------------------------------------------------------------------
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database_name>
# Untuk pengembangan lokal, jalankan dulu PostgreSQL dari root proyek:
#   docker compose up -d
# Aplikasi TIDAK berjalan tanpa PostgreSQL (dukungan SQLite sudah dihapus).
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/ABAP_DB

# ------------------------------------------------------------------------------
# 2. AUTENTIKASI & KEAMANAN JWT (WAJIB DI PRODUKSI)
# ------------------------------------------------------------------------------
# Ganti dengan secret key unik Anda (contoh: buat via `openssl rand -base64 48`)
SESSION_SECRET=your-random-session-secret-key-here-please-change-in-production
# ------------------------------------------------------------------------------
# 3. BOOTSTRAP SUPER ADMIN (Inisialisasi Pertama)
# ------------------------------------------------------------------------------
# Password awal akun 'TRSTDEV' ketika pertama kali database diinisialisasi.
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2024

# ------------------------------------------------------------------------------
# 4. DEPLOYMENT & JARINGAN (Opsional)
# ------------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=*
GUEST_DAILY_LIMIT=1
LOGIN_MAX_FAILURES=8
LOGIN_LOCK_SECONDS=900

# Anggaran token riwayat percakapan yang disertakan ke model tiap giliran.
# Makin kecil makin hemat, tetapi ingatan percakapan makin pendek.
HISTORY_TOKEN_BUDGET=3000

# ------------------------------------------------------------------------------
# 5. CENTRALIZED IDENTITY (OIDC) & UNIFIED MCP GATEWAY (WAJIB)
# Autentikasi dan akses MCP terpusat melalui Dashboard MCP.
# Tidak ada koneksi langsung ke upstream MCP atau token statis warisan.
DASHBOARD_OIDC_ISSUER=http://127.0.0.1:4000
DASHBOARD_OIDC_CLIENT_ID=sap-ai-assistant
DASHBOARD_OIDC_CLIENT_SECRET=
DASHBOARD_OIDC_REDIRECT_URI=http://localhost:5173/api/auth/callback
DASHBOARD_MCP_GATEWAY_URL=http://127.0.0.1:4000/v1/gateway

# ==============================================================================
# ℹ️ CATATAN TENTANG KONFIGURASI AI MODEL & CENTRALIZED MCP:
# - AI Provider dikonfigurasi melalui Database / Admin UI.
# - MCP routing berjalan terpusat melalui DASHBOARD_MCP_GATEWAY_URL.
# - Seluruh izin akses perkakas (tools) dievaluasi dinamis dari bundle Dashboard.
# ==============================================================================
# Auto-detect text files and perform LF normalization
* text=auto eol=lf

# Force shell scripts to always be LF
*.sh text eol=lf
*.bash text eol=lf

# Force source code files to always be LF
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
